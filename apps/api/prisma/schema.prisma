generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String    @id @default(uuid())
  name            String
  routingStrategy String    @default("SHARED") // "SHARED" or "DEDICATED"
  schema          String    @default("public")

  // Business Profile Fields
  employeeCount   Int?
  numberOfBranches Int?
  annualTurnover  Float?
  gstin           String?
  businessType    String?
  dataSensitivity String    @default("STANDARD") // "STANDARD", "HIGH", "STRICT"
  expectedTxVolume Int?
  enterpriseRequirements String?
  
  users           User[]
  expenses        Expense[]
  budgets         Budget[]
  policyRules     PolicyRule[]
  policyViolations PolicyViolation[]
  vendors         Vendor[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      String    @default("EMPLOYEE") // EMPLOYEE, ADMIN, MANAGER
  
  // Extra Info
  name          String?
  department    String?
  location      String?
  costCenter    String?
  manager       String?
  spendingLimit String?
  approvalAuth  String?

  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  
  expenses  Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String
  
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  
  amount        Float
  currency      String    @default("INR")
  vendor        String
  category      String?
  date          DateTime
  project       String?
  department    String?

  receiptUrl    String?
  status        String    @default("PENDING") // PENDING, APPROVED, FLAGGED, REJECTED
  anomalyScore  Float?

  eventHash     String?   @unique
  prevEventHash String?

  violations    PolicyViolation[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Budget {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  month       String    // format YYYY-MM
  department  String
  amount      Float

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PolicyRule {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  name        String
  description String?
  type        String?
  category    String?
  maxAmount   Float?
  severity    String?
  active      Boolean   @default(true)

  violations  PolicyViolation[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PolicyViolation {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  expenseId   String
  expense     Expense   @relation(fields: [expenseId], references: [id])
  
  ruleId      String
  rule        PolicyRule @relation(fields: [ruleId], references: [id])
  
  reason      String

  createdAt   DateTime  @default(now())
}

model Vendor {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  name        String
  gstin       String?
  contact     String?
  category    String?
  terms       String?
  spend       String?
  contract    String?
  invoices    Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
